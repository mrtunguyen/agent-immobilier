# Copy to .env for local development. Never commit .env.

# Dedicated Gmail account receiving the property alert emails (README step 1).
# GMAIL_APP_PASSWORD is a Google App Password, not the account password: 2-Step
# Verification must be on, and Google shows it as "abcd efgh ijkl mnop" — paste
# the 16 characters with the spaces removed.
# Check it with: python -m scout.gmail_client
GMAIL_ADDRESS=your.scout@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# @BotFather -> /newbot ; chat id from @userinfobot
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=123456789

# notion.so/my-integrations ; database must be shared with the integration
NOTION_TOKEN=ntn_...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: skip a delivery channel by leaving its variables empty.
